# --- ESP-IDF 构建产物 ---
build/
build_host/
build_ui/
managed_components/
*.bin
*.elf
*.map
*.uf2
flasher_args.json

# main/ 下的 .bin 是固件资源（themes/sprites/signs/字体/音效），构建必需，必须入库。
# 上面的 *.bin 只用于拦构建产物；这里的否定规则把资源放回来。
!main/*.bin

# --- 本地配置（sdkconfig.defaults 受版本管理，sdkconfig 由它生成）---
sdkconfig
sdkconfig.old
sdkconfig.ci

# --- 工具链与本地环境 ---
.espressif/
.env

# --- 日志与临时文件 ---
*.log
build*.log
*.tmp
*.bak
*.swp
logs/

# --- IDE / 编辑器缓存 ---
.vscode/
.idea/
.cache/
compile_commands.json

# Generated repository-local links; canonical skill sources live in skills/.
/.agents/skills/passport-develop
/.agents/skills/passport-setup
/.agents/skills/passport-build
/.agents/skills/passport-device-test
/.agents/skills/passport-debug
