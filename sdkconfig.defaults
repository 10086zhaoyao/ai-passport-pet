# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# 坦克大战的精灵/HUD 对象较多。48KB 在真机上实测不足:开机一次性构建
# 首页/设置/指引/ACE/表盘 5 屏 + 游戏 HUD 约 200 个对象,lv_obj_create
# 返回 NULL 后触发 LVGL 断言 while(1),表现为背光亮但白屏。
# 实测 96KB 时空闲仅 40.8KB，切 SoftAP 时 WiFi 动态缓冲申请失败（alloc eb len=752）
# 直接 Load access fault 复位。收到 72KB 后再收到 64KB：对象稳态占用约 48KB
# （PERF pool_max=48080B），仍留 ~15KB 余量；把这 8KB 还给系统堆，供开热点+httpd 用。
# 若真机出现 lv_obj_create 返回 NULL 白屏，再回调到 72KB。
# LVGL 池：实测峰值 46,692 B，64K 里有约 27 KB 长期闲置。
# 收到 56K（实际池 52,588 B），把 8 KB 还给系统堆给 WiFi 门户用，同时保留约 5.9 KB 余量。
CONFIG_LV_MEM_SIZE_KILOBYTES=56

# --- WiFi 缓冲（C3 内存紧，按最小可用配）---
# 静态 RX 2 / 动态 RX 4 / 动态 TX 4：门户起来后实测只剩 9.4KB，httpd(8KB 栈) 起不来；
# 每条动态缓冲 1600B，各减 2 条还给堆 6.4KB。RX_BA_WIN 必须 ≤ 2×静态 RX
# （IDF 编译期 #error 强制），所以 2 静态 → BA 窗 4。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=12

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE / NimBLE ---
# 坦克大战不依赖无线功能:关闭蓝牙,把 RAM 与 Flash 留给 LVGL 和音频。
CONFIG_BT_ENABLED=n
